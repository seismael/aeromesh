{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AeroMesh Declarative Mesh Workflow (DWM v1.0) Schema",
  "type": "object",
  "required": ["workflow_version", "identity", "steps"],
  "properties": {
    "workflow_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "identity": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "schedule": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "intent"],
        "properties": {
          "id": { "type": "string" },
          "agent_id": { "type": "string" },
          "manifest": { "type": "string" },
          "intent": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
