{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aeromesh:schemas:declarative-workflow:0.2.0",
  "title": "AeroMesh Declarative Workflow Manifest (DWM)",
  "description": "Explicit dependency DAG of immutable agent references.",
  "type": "object",
  "required": [
    "workflow_version",
    "identity",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "workflow_version": {
      "type": "string",
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent_id",
          "intent"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "agent_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "intent": {
            "type": "string",
            "description": "Task for this step; {step_id} placeholders inject upstream results."
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
            }
          },
          "agent_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 256
    },
    "output": {
      "type": "string",
      "description": "Optional step id whose result is the workflow's final answer."
    }
  }
}
