{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aeromesh:schemas:declarative-agent:0.1.0",
  "title": "AeroMesh Declarative Agent Manifest",
  "description": "Declarative Agent Manifest (DAM) v0.1 schema for portable, signed, sandboxed AI agents.",
  "type": "object",
  "required": [
    "manifest_version",
    "identity",
    "capabilities",
    "cognitive_runtime",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the DAM specification standard (currently '0.1.0')."
    },
    "identity": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-_]+$",
          "description": "Unique, machine-readable, URL-safe identifier for the declarative agent."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Human-readable name of the agent."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of this specific agent manifest configuration."
        },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "funding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["domain", "tags", "short_description", "evaluation_trigger"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string" },
        "sub_domain": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "short_description": { "type": "string", "maxLength": 300 },
        "evaluation_trigger": { "type": "string" },
        "input_contract": {
          "type": "object",
          "description": "JSON Schema validating incoming task arguments or payload."
        },
        "output_contract": {
          "type": "object",
          "description": "JSON Schema validating final output data generated by this agent."
        }
      }
    },
    "cognitive_runtime": {
      "type": "object",
      "required": ["persona", "success_criteria"],
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["Driver.LangGraph", "Driver.WasmSandbox", "Driver.NativeAsync", "Driver.RemoteModel"],
          "default": "Driver.LangGraph",
          "description": "Preferred Cognitive Driver Interface (CDI) runtime driver."
        },
        "persona": { "type": "string" },
        "success_criteria": { "type": "string" },
        "memory_policy": {
          "type": "string",
          "enum": ["CVM_LRU_PAGING", "FULL_CONTEXT", "EPHEMERAL_STREAM"],
          "default": "CVM_LRU_PAGING"
        },
        "checkpoint_policy": {
          "type": "string",
          "enum": ["ON_EVENT", "ON_STEP", "DISABLED"],
          "default": "ON_STEP"
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["providers"],
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["mcp", "credential", "skill", "sub_agent", "security", "storage_adapter", "custom_plugin"]
              },
              "id": { "type": "string" },
              "transport": { "type": "string", "enum": ["stdio", "sse"] },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "uri": { "type": "string" },
              "required_tools": { "type": "array", "items": { "type": "string" } },
              "kind": { "type": "string" },
              "fallback_action": { "type": "string" },
              "isolation": { "type": "string" },
              "allowed_domains": { "type": "array", "items": { "type": "string" } },
              "agent_id": { "type": "string" },
              "delegation_purpose": { "type": "string" }
            }
          }
        }
      }
    },
    "swarm_topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["hierarchical", "pipeline", "mesh_consensus", "pub_sub"],
          "default": "hierarchical"
        },
        "consensus_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "routing_key": { "type": "string" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "cost_limit_usd": { "type": "number" },
        "max_execution_steps": { "type": "integer" }
      }
    }
  }
}
