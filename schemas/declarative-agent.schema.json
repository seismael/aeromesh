{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:aeromesh:schemas:declarative-agent:0.2.0",
  "title": "AeroMesh Declarative Agent Manifest",
  "description": "Versioned agent configuration with enforced execution contracts.",
  "type": "object",
  "required": [
    "manifest_version",
    "identity",
    "capabilities",
    "cognitive_runtime",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Human-readable name of the agent."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of this specific agent manifest configuration."
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "funding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "domain",
        "tags",
        "short_description",
        "evaluation_trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "sub_domain": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "short_description": {
          "type": "string",
          "maxLength": 300
        },
        "evaluation_trigger": {
          "type": "string"
        },
        "input_contract": {
          "type": "object",
          "description": "JSON Schema validating incoming task arguments or payload."
        },
        "output_contract": {
          "type": "object",
          "description": "JSON Schema validating final output data generated by this agent."
        }
      }
    },
    "cognitive_runtime": {
      "type": "object",
      "required": [
        "persona",
        "success_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "Driver.LangGraph"
          ],
          "default": "Driver.LangGraph"
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "string",
          "minLength": 1
        },
        "memory_policy": {
          "type": "string",
          "enum": [
            "NATIVE",
            "EPHEMERAL_STREAM"
          ],
          "default": "NATIVE"
        },
        "checkpoint_policy": {
          "type": "string",
          "enum": [
            "ON_STEP",
            "DISABLED"
          ],
          "default": "ON_STEP"
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "providers"
      ],
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "transport"
                ],
                "properties": {
                  "type": {
                    "const": "mcp"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  "transport": {
                    "enum": [
                      "stdio",
                      "sse",
                      "http"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "string"
                    }
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
                  },
                  "uri": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "required_tools": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allowed_domains": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "credential_bindings": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[A-Z][A-Z0-9_]*$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    }
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "transport": {
                        "const": "stdio"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "command"
                        ],
                        "not": {
                          "required": [
                            "image"
                          ]
                        }
                      },
                      {
                        "required": [
                          "image"
                        ],
                        "not": {
                          "required": [
                            "command"
                          ]
                        }
                      }
                    ],
                    "not": {
                      "required": [
                        "uri"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "transport": {
                        "enum": [
                          "sse",
                          "http"
                        ]
                      }
                    },
                    "required": [
                      "uri"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "command"
                          ]
                        },
                        {
                          "required": [
                            "image"
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "credential"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  "kind": {
                    "enum": [
                      "credential",
                      "api_key",
                      "connection_string",
                      "bearer_token",
                      "password"
                    ]
                  },
                  "fallback_action": {
                    "enum": [
                      "prompt_user"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "agent_id"
                ],
                "properties": {
                  "type": {
                    "const": "sub_agent"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  "agent_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                  },
                  "agent_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "delegation_purpose": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "swarm_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "enum": [
            "hierarchical"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost_limit_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_execution_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "input_price_per_million": {
          "type": "number",
          "minimum": 0
        },
        "output_price_per_million": {
          "type": "number",
          "minimum": 0
        }
      },
      "dependencies": {
        "cost_limit_usd": [
          "max_output_tokens",
          "input_price_per_million",
          "output_price_per_million"
        ]
      }
    }
  }
}
